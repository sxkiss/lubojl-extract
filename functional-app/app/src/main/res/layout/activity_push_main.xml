<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF6200EE"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">
        <ImageButton android:id="@+id/btn_back"
            android:layout_width="40dp" android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="推流直播"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 悬浮窗权限 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="悬浮窗权限" android:textSize="16sp"/>
                <TextView android:id="@+id/tv_float_status"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="未开启" android:textColor="#999999"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E0E0E0" android:layout_marginBottom="12dp"/>

            <!-- 视频地址 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="视频地址" android:textSize="16sp"/>
                <EditText android:id="@+id/et_video_url"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="2" android:hint="输入直播/视频地址"
                    android:inputType="textUri" android:singleLine="true"
                    android:background="@drawable/item_bg" android:paddingHorizontal="12dp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E0E0E0" android:layout_marginBottom="12dp"/>

            <!-- 推流类型 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="推流模式" android:textSize="16sp"/>
                <RadioGroup android:id="@+id/rg_push_type"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="2" android:orientation="horizontal">
                    <RadioButton android:id="@+id/rb_push_remote"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="远程推流" android:checked="true"/>
                    <RadioButton android:id="@+id/rb_push_local"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="本地文件"/>
                    <RadioButton android:id="@+id/rb_push_obs"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="OBS"/>
                </RadioGroup>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E0E0E0" android:layout_marginBottom="12dp"/>

            <!-- 推流地址 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="推流地址" android:textSize="16sp"/>
                <EditText android:id="@+id/et_push_address"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="2" android:hint="rtmp://your-endpoint"
                    android:inputType="textUri" android:singleLine="true"
                    android:background="@drawable/item_bg" android:paddingHorizontal="12dp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E0E0E0" android:layout_marginBottom="12dp"/>

            <!-- 推流密钥 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="推流密钥" android:textSize="16sp"/>
                <EditText android:id="@+id/et_push_key"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="2" android:hint="输入推流密钥"
                    android:inputType="textPassword" android:singleLine="true"
                    android:background="@drawable/item_bg" android:paddingHorizontal="12dp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E0E0E0" android:layout_marginBottom="16dp"/>

            <!-- 按钮 -->
            <Button android:id="@+id/btn_parse"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="视频解析" android:layout_marginBottom="8dp"/>

            <Button android:id="@+id/btn_start"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="开始直播" android:textSize="18sp"
                android:backgroundTint="#FF4CAF50" android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <Button android:id="@+id/btn_save_push"
                android:layout_width="match_parent" android:layout_height="48dp"
                android:text="保存设置"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="说明：请在直播平台获取推流地址和密钥" android:textSize="12sp"
                android:textColor="#999999" android:gravity="center" android:layout_marginTop="8dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>