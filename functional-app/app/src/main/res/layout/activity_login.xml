<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp" android:background="#F5F5F5">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="鹿播精灵" android:textSize="36sp" android:textStyle="bold" android:textColor="#FF6200EE"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="AI录屏直播助手" android:textSize="14sp" android:textColor="#999999" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/tv_notice"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="12sp" android:textColor="#FF9800"
        android:gravity="center" android:layout_marginTop="16dp"/>

    <EditText android:id="@+id/et_card_key"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:hint="请输入卡密" android:inputType="text"
        android:layout_marginTop="40dp"
        android:background="@drawable/item_bg" android:paddingHorizontal="16dp"
        android:textSize="16sp"/>

    <Button android:id="@+id/btn_login"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="激活登录" android:textSize="16sp"
        android:layout_marginTop="24dp"
        android:backgroundTint="#FF6200EE"/>

    <TextView android:id="@+id/tv_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textSize="13sp" android:textColor="#FF0000"
        android:gravity="center" android:layout_marginTop="12dp"/>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="卡密由管理员生成，激活后绑定设备" android:textSize="11sp"
        android:textColor="#AAAAAA" android:gravity="center" android:layout_marginTop="8dp"/>
</LinearLayout>